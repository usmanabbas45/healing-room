generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String?
  name             String
  image            String?
  role             String   @default("user") // "user" or "staff"
  hikeupCustomerId String?  // Hikeup POS customer ID for syncing
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart     Cart?
  wishlist Wishlist?
  orders   Order[]
}

// Local products (optional - mainly for fallback when Hikeup is unavailable)
model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  category    String
  sizes       String[]
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  priceId   String
  color     String
  images    String[]
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// CartItem stores product info directly (no foreign key to Product)
// This allows adding Hikeup products that aren't in our local DB
model CartItem {
  id          String  @id @default(cuid())
  cartId      String
  cart        Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String  // Hikeup product ID (stored as string, not a foreign key)
  variantId   String?
  size        String
  quantity    Int
  price       Float
  // Store product info for display
  productName String  @default("")
  category    String  @default("")
  image       String? // Product image URL
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// WishlistItem stores product info directly (no foreign key to Product)
model WishlistItem {
  id          String  @id @default(cuid())
  wishlistId  String
  wishlist    Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId   String  // Hikeup product ID (stored as string, not a foreign key)
  productName String  @default("")
  category    String  @default("")
  image       String?
  price       Float   @default(0)
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                OrderItem[]
  totalPrice           Float
  status               String      @default("pending") // pending, confirmed, processing, ready, completed, cancelled
  
  // Customer info (optional - for pickup orders)
  customerName         String?
  customerEmail        String?
  customerPhone        String?
  
  // Shipping/pickup info (optional)
  shippingName         String?
  shippingEmail        String?
  shippingPhone        String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingPostalCode   String?
  shippingCountry      String?
  
  // Order notes
  notes                String?

  purchaseDate         DateTime    @default(now())
  expectedDeliveryDate DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

// OrderItem stores product info directly (no foreign key to Product)
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String  // Hikeup product ID
  variantId   String?
  size        String
  quantity    Int
  price       Float
  color       String?
  image       String?
  productName String  @default("")
  category    String  @default("")
}

// Settings for storing app configuration like API tokens
model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
