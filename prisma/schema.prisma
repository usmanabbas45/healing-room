generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String?
  name             String
  image            String?
  role             String   @default("user") // "user" or "staff"
  hikeupCustomerId String?  // Hikeup POS customer ID for syncing
  
  // Optional contact info
  phone            String?
  
  // Optional saved address
  addressLine1     String?
  addressLine2     String?
  city             String?
  province         String?
  postalCode       String?
  country          String?  @default("Canada")
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart     Cart?
  wishlist Wishlist?
  orders   Order[]
}

// Local products (optional - mainly for fallback when Hikeup is unavailable)
model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  category    String
  sizes       String[]
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  priceId   String
  color     String
  images    String[]
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// CartItem stores product info directly (no foreign key to Product)
// This allows adding Hikeup products that aren't in our local DB
model CartItem {
  id                  String  @id @default(cuid())
  cartId              String
  cart                Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId           String  // Hikeup product ID (stored as string, not a foreign key)
  variantId           String?
  size                String
  quantity            Int
  price               Float   // Final price after discount
  // Discount information (if applicable)
  originalPrice       Float?  // Price before discount
  discountPercentage  Float?  // Discount percentage (e.g., 15.0 for 15%)
  discountAmount      Float?  // Fixed discount amount
  offerName           String? // Name of the offer/deal
  // Store product info for display
  productName         String  @default("")
  category            String  @default("")
  image               String? // Product image URL
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// WishlistItem stores product info directly (no foreign key to Product)
model WishlistItem {
  id          String  @id @default(cuid())
  wishlistId  String
  wishlist    Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId   String  // Hikeup product ID (stored as string, not a foreign key)
  productName String  @default("")
  category    String  @default("")
  image       String?
  price       Float   @default(0)
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                OrderItem[]
  
  // Pricing
  subtotal             Float       @default(0)
  deliveryFee          Float       @default(0)
  totalPrice           Float
  
  // Order status
  status               String      @default("awaiting_payment") 
  // awaiting_payment, paid, processing, ready_for_pickup, out_for_delivery, shipped, delivered, completed, cancelled, refunded
  
  // Payment
  paymentMethod        String      @default("etransfer") // etransfer, cash_on_delivery
  paymentStatus        String      @default("pending") // pending, received, confirmed, failed
  paymentReference     String?     // e-transfer confirmation or reference number
  paidAt               DateTime?
  
  // Fulfillment method
  fulfillmentMethod    String      @default("pickup") // pickup, delivery, shipping
  
  // Customer info
  customerName         String
  customerEmail        String
  customerPhone        String?
  
  // Delivery/Shipping address (for delivery and shipping orders)
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  deliveryCity         String?
  deliveryProvince     String?
  deliveryPostalCode   String?
  deliveryCountry      String?     @default("Canada")
  
  // Delivery specifics
  deliveryDate         DateTime?   // Scheduled delivery date
  deliveryTimeSlot     String?     // e.g., "12pm-3pm", "3pm-6pm", "6pm-9pm"
  deliveryInstructions String?     // Special delivery instructions
  deliveryDistance     Float?      // Distance in km from store
  
  // Shipping specifics
  trackingNumber       String?     // Canada Post tracking number for shipped orders
  shippedAt            DateTime?   // When the order was shipped
  
  // Order notes (internal)
  notes                String?
  staffNotes           String?     // Notes from staff

  purchaseDate         DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  
  @@index([status])
  @@index([paymentStatus])
  @@index([userId])
}

// OrderItem stores product info directly (no foreign key to Product)
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String  // Hikeup product ID
  variantId   String?
  size        String
  quantity    Int
  price       Float
  color       String?
  image       String?
  productName String  @default("")
  category    String  @default("")
}

// Settings for storing app configuration like API tokens
model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Password reset tokens
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6-digit verification code
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([email])
  @@index([code])
}

// Hikeup integration event logs
model HikeupLog {
  id               String   @id @default(cuid())
  eventType        String   // "token_deleted", "token_refreshed", "token_created", "refresh_failed", "api_error"
  message          String
  endpoint         String?  // API endpoint that triggered the event
  statusCode       Int?     // HTTP status code from Hikeup
  tokenAge         Int?     // Token age in days
  tokenExpired     Boolean?
  hadRefreshToken  Boolean?
  errorResponse    String?  // Raw error response from Hikeup (max 1000 chars)
  metadata         String?  // JSON string for additional context
  createdAt        DateTime @default(now())
  
  @@index([eventType])
  @@index([createdAt])
}

// Cache for Hikeup products (stored in database for multi-worker access)
model HikeupProductCache {
  id               String   @id @default(cuid())
  hikeupId         Int      @unique // Hikeup product ID
  name             String   // For search
  rawData          String   // Full JSON product data from Hikeup
  productTypes     String[] // Array of type names for filtering (e.g., ["nicotine", "vape"])
  isActive         Boolean  @default(true)
  hasVariants      Boolean  @default(false)
  lastModified     DateTime? // Hikeup's last_modified timestamp
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([hikeupId])
  @@index([isActive])
  @@index([productTypes])
  @@index([lastModified])
}
